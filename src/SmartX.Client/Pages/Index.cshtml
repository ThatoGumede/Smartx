@page
@model IndexModel
@{
    ViewData["Title"] = "Smart-X Gateway";
}

<div class="mb-4">
    <h1 class="display-6 fw-bold">Smart-X IoT Mesh Ecosystem</h1>
    
    <p class="text-secondary">
        Ingestion and configuration console for the distributed ESP32 sensor mesh. Choose an
        architectural pillar below.
    </p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 pillar-card pillar-enabled">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Sensor Data Ingestion &amp; Telemetry</h5>
                <p class="card-text text-secondary flex-grow-1">
                    Register sensors, ingest live telemetry (float / int / bool), attach device
                    media, validate deployment trees, and watch the pre-attentive engagement
                    dashboard.
                </p>
                <a asp-page="/Sensors" class="btn btn-primary mt-auto">Open Sensor Console</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 pillar-card pillar-enabled">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Real-Time Command Stream &amp; History</h5>
                <p class="card-text text-secondary flex-grow-1">
                    Live device stream with search and filters, manual override commands with undo,
                    the priority intake queue, and predictive Suggested Actions.
                </p>
                <a asp-page="/CommandStream" class="btn btn-primary mt-auto">Open Command Stream</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 pillar-card pillar-enabled">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Network Topology &amp; Mesh Routing</h5>
                <p class="card-text text-secondary flex-grow-1">
                    The live mesh as a graph, routes traced to the gateway by MAC address, self-healing
                    around failed nodes, and an indexed history for every sensor.
                </p>
                <a asp-page="/Topology" class="btn btn-primary mt-auto">Open Network Topology</a>
            </div>
        </div>
    </div>
</div>
