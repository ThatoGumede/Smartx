@page
@model SensorsModel
@{
    ViewData["Title"] = "Sensor Ingestion";
}

<h1 class="h3 mb-3">Sensor Data Ingestion &amp; Telemetry</h1>
<p class="text-secondary">
    Register a sensor payload, attach device media, and validate its deployment location
    against the nested Facility &rarr; Zone &rarr; Sub-Zone &rarr; Node tree. Newly registered
    sensors start receiving simulated telemetry once the device simulator is running, so you can see them appear on
    the <a asp-page="/Dashboard">live dashboard</a> within a few seconds.
</p>

<div class="row g-4">
    <!-- Registration -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">Register Sensor Payload</div>
            <div class="card-body">
                <form id="registerForm" novalidate>
                    <div class="mb-3">
                        <label class="form-label">Device Name (optional)</label>
                        <input type="text" class="form-control" id="sensorName" placeholder="Pump A">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Device MAC Address / Unique Identifier</label>
                        <input type="text" class="form-control" id="macAddress" placeholder="24:6F:28:AA:01:09" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sensor Deployment Location</label>
                        <input type="text" class="form-control" id="deploymentLocation"
                               placeholder="Facility A / Zone 1 / Sub-Zone B / Node 6" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sensor Category</label>
                        <select class="form-select" id="category">
                            <option value="Environmental">Environmental</option>
                            <option value="PowerConsumption">Power Consumption</option>
                            <option value="Actuator">Actuator</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Register Sensor</button>
                    <span id="registerStatus" class="ms-2 small"></span>
                </form>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">Deployment Tree Validation (Recursive)</div>
            <div class="card-body">
                <p class="small text-secondary">
                    Paste or edit a deployment tree, then validate it. Validation walks the
                    tree recursively, tier by tier (Facility &rarr; Zone &rarr; SubZone &rarr; Node).
                </p>
                <textarea id="deploymentTree" class="form-control font-monospace small" rows="10"></textarea>
                <div class="mt-2">
                    <button id="loadSampleBtn" class="btn btn-outline-secondary btn-sm">Load Sample Tree</button>
                    <button id="validateBtn" class="btn btn-primary btn-sm">Validate</button>
                </div>
                <div id="validationResult" class="mt-3"></div>
            </div>
        </div>
    </div>

    <!-- Sensor list + media -->
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Registered Sensors</span>
                <button id="refreshSensorsBtn" class="btn btn-sm btn-outline-secondary">Refresh</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Location</th>
                            <th>Category</th>
                            <th>MAC</th>
                            <th>Attachments</th>
                            <th>Attach File</th>
                        </tr>
                    </thead>
                    <tbody id="sensorTableBody">
                        <tr><td colspan="5" class="text-center text-secondary py-3">Loading&hellip;</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script data-page-script src="~/js/sensors.js" asp-append-version="true"></script>
}
